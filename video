<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Animated Colorful Background */
        body {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
            margin: 0;
            overflow: hidden; /* Prevents scrollbars during transitions */
            font-family: 'Inter', sans-serif;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Screen Transition Logic */
        .screen {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
            transform: translateY(20px);
        }

        .screen.active {
            display: flex;
            opacity: 1;
            transform: translateY(0);
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body class="min-h-screen text-white selection:bg-white selection:text-pink-600 relative">

    <!-- SCREEN 1: Start Button -->
    <div id="screen1" class="screen active min-h-screen w-full px-4 text-center absolute inset-0">
        <button onclick="goToScreen(1, 2)" class="px-12 py-5 bg-white text-pink-600 text-4xl md:text-5xl font-black rounded-full shadow-[0_10px_25px_rgba(0,0,0,0.2)] hover:shadow-[0_15px_35px_rgba(0,0,0,0.3)] hover:scale-110 hover:-translate-y-2 active:scale-95 transition-all duration-300 transform">
            Start
        </button>
    </div>

    <!-- SCREEN 2: Question & Options -->
    <div id="screen2" class="screen min-h-screen w-full px-6 text-center absolute inset-0">
        <div class="bg-white/20 backdrop-blur-lg p-8 md:p-12 rounded-3xl shadow-2xl border border-white/30 max-w-2xl w-full">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold drop-shadow-lg mb-4 leading-tight">
                link🔗 lene ke liye jawab de
            </h1>
            <h2 class="text-4xl md:text-5xl font-black text-yellow-300 drop-shadow-md mb-10 mt-6">
                kya app gay ho?
            </h2>
            
            <div class="flex flex-col gap-5 w-full items-center">
                <button onclick="goToScreen(2, 3)" class="w-full max-w-sm px-6 py-4 bg-blue-500 text-white text-xl md:text-2xl font-bold rounded-2xl shadow-lg border-b-4 border-blue-700 hover:bg-blue-400 hover:border-blue-500 hover:scale-105 active:scale-95 active:border-b-0 active:translate-y-1 transition-all duration-200 transform">
                    yes me hun
                </button>
                <button onclick="goToScreen(2, 3)" class="w-full max-w-sm px-6 py-4 bg-purple-500 text-white text-xl md:text-2xl font-bold rounded-2xl shadow-lg border-b-4 border-purple-700 hover:bg-purple-400 hover:border-purple-500 hover:scale-105 active:scale-95 active:border-b-0 active:translate-y-1 transition-all duration-200 transform">
                    han me hi hun koi shaq hai
                </button>
            </div>
        </div>
    </div>

    <!-- SCREEN 3: The Link -->
    <div id="screen3" class="screen min-h-screen w-full px-4 text-center absolute inset-0">
        <h1 class="text-4xl md:text-6xl font-black drop-shadow-2xl mb-12 animate-pulse text-white">
            ( ye le gay lele link )
        </h1>
        
        <a href="https://desikamababa.com/18-yr-old-punjabi-girl-soft-boobs-in-nude-leaked-mms/#_" target="_blank" class="inline-block px-10 py-5 bg-green-500 text-white text-2xl md:text-3xl font-bold rounded-full shadow-[0_10px_20px_rgba(0,255,0,0.3)] border-4 border-white hover:bg-green-400 hover:scale-110 active:scale-95 transition-all duration-300 transform animate-bounce">
            Click here to open link
        </a>
    </div>

    <script>
        function goToScreen(current, next) {
            const currentScreen = document.getElementById(`screen${current}`);
            const nextScreen = document.getElementById(`screen${next}`);

            // Fade out current screen
            currentScreen.style.opacity = '0';
            currentScreen.style.transform = 'translateY(-20px)';
            
            // Wait for transition, then hide current and show next
            setTimeout(() => {
                currentScreen.classList.remove('active');
                
                nextScreen.classList.add('active');
                
                // Slight delay to ensure display:flex is applied before starting fade-in
                requestAnimationFrame(() => {
                    nextScreen.style.opacity = '1';
                    nextScreen.style.transform = 'translateY(0)';
                });
                
            }, 500); // 500ms matches the CSS transition time
        }
    </script>
</body>
</html>